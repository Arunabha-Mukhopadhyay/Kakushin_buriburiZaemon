// ArthSaathi — Prisma schema
// Postgres backs all structured/relational state.
// FAISS (separate, file-based) continues to handle RAG/semantic search —
// no overlap: this DB never stores embeddings or vector indices.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// ---------- Enums ----------

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ABANDONED
}

enum AgentRunStatus {
  SUCCESS
  FAILURE
  PARTIAL
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// Employment type drives scheme eligibility and income volatility scoring
enum EmploymentType {
  SALARIED
  GIG            // Zomato, Swiggy, Ola, Uber, etc.
  SELF_EMPLOYED  // Shop owner, freelancer, consultant
  FARMER
  DAILY_WAGE
  UNEMPLOYED
}

// Risk appetite drives which Monte Carlo path is recommended
enum RiskAppetite {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
}

// Gender drives Stand Up India eligibility and Sukanya Samriddhi Yojana
enum Gender {
  MALE
  FEMALE
  OTHER
}

// Caste category drives Stand Up India eligibility
enum CasteCategory {
  GENERAL
  OBC
  SC
  ST
}



// ---------- Core identity ----------
model User {
  id            String   @id @default(cuid())
  phone         String?  @unique
  email         String?  @unique
  name          String?
  preferredLang String   @default("en") // en, hi, mr, kn — matches embedding model's language coverage
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  financialProfile FinancialProfile?
  goals            Goal[]
  sessions         ConversationSession[]
  agentRuns        AgentRun[]
  scamAlerts       ScamAlert[]
  schemeMatches    SchemeMatch[]
  simulations      SimulationResult[]
}



// ---------- Inputs to the parallel agents ----------
// Feeds Financial Analysis Agent, Risk Assessment Agent, Scheme Matching Agent
model FinancialProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- Core financials (Financial Analysis Agent) ---
  monthlyIncome   Decimal
  monthlyExpenses Decimal
  monthlyEmi      Decimal  @default(0)  // monthly EMI payments — used separately in DTI calc
  existingSavings Decimal  @default(0)
  existingDebt    Decimal  @default(0)
  dependents      Int      @default(0)
  employmentType  EmploymentType @default(SALARIED)

  // --- Demographics (Government Scheme Matching Agent) ---
  age                Int?            // APY: 18–40, PMSBY: 18–70, SCSS: 60+
  gender             Gender?         // Stand Up India, Sukanya Samriddhi
  state              String?         // State-specific schemes (e.g. Arogyashri for AP/Telangana)
  isRural            Boolean         @default(false)  // PMAY-G vs PMAY-U, PM Kisan
  casteCategory      CasteCategory?  // Stand Up India requires SC/ST or women
  landHoldingAcres   Decimal?        // PM Kisan eligibility (farmers only)
  businessType       String?         // MUDRA tier (retail/service/manufacturing) — self-employed only

  // --- Insurance & banking gaps (Scheme Matching Agent) ---
  hasBankAccount     Boolean  @default(true)   // false → Jan Dhan priority
  hasInsurance       Boolean  @default(false)  // false → PMSBY + PMJJBY recommendation
  hasHealthInsurance Boolean  @default(false)  // false → PMJAY eligibility check

  // --- Simulation inputs (Future Simulation Agent) ---
  riskAppetite    RiskAppetite @default(MODERATE)  // drives Monte Carlo path selection

  // --- Credibility Engine output (stored after pre-flight validation) ---
  credibilityScore  Float?    // 0–100, computed in Python before agents run
  credibilityFlags  String[]  // e.g. ["debt_exceeds_annual_income"]

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  riskAssessments RiskAssessment[]
}



// Feeds / consumed by Goal Discovery Agent and Future Simulation Agent
model Goal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title        String        // e.g. "Buy a house", "Child's education"
  targetAmount Decimal
  targetDate   DateTime?     // optional — use horizonMonths if date unknown
  horizonMonths Int?         // alternative to targetDate — easier for Monte Carlo input
  priority     Int           @default(0) // for Coach Agent to sequence advice
  status       GoalStatus    @default(ACTIVE)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  simulations SimulationResult[]
}



// ---------- Outputs of the parallel agents ----------
// Output of Risk Assessment Agent
model RiskAssessment {
  id                 String   @id @default(cuid())
  financialProfileId String
  financialProfile   FinancialProfile @relation(fields: [financialProfileId], references: [id], onDelete: Cascade)

  riskScore       Float    // composite 0–100, computed in Python
  riskCategory    String   // low / moderate / high
  factors         Json     // { debtScore, emergencyScore, incomeScore, surplusScore, investmentScore }
  healthSummary   String?  // one-line plain-language summary for Explainability Agent

  createdAt DateTime @default(now())
}



// Output of Scam Detection Agent
model ScamAlert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  inputText         String    // the message/scheme/offer the user asked about
  isFlagged         Boolean
  confidence        Float
  scamType          String?   // e.g. "digital_arrest", "fake_kyc", "investment_doubling"
  matchedPatternIds String[]  // references into Scam Patterns FAISS store

  createdAt DateTime @default(now())
}



// Output of Government Scheme Matching Agent
model SchemeMatch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  schemeName      String
  eligible        Boolean
  annualBenefit   Decimal? // estimated monetary value of the scheme if enrolled
  eligibilityGap  String?  // if not eligible, what's missing — for Coach Agent to act on
  howToApply      String?  // brief instruction for Accessibility Agent to narrate
  sourceDocIds    String[] // references into Government Schemes FAISS store

  createdAt DateTime @default(now())
}



// ---------- Outputs of the sequential agents ----------
// Output of Future Simulation Agent (Monte Carlo / NumPy — Python owns the math)
model SimulationResult {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId    String?
  goal      Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)

  scenario        String   // "status_quo" | "moderate" | "optimal"
  successProb     Float    // Monte Carlo probability of reaching the goal (0–1)
  projectedValue  Decimal  // median projected corpus at horizon
  p10Value        Decimal  // 10th percentile (pessimistic outcome)
  p90Value        Decimal  // 90th percentile (optimistic outcome)
  horizonMonths   Int
  rawOutput       Json     // full simulation payload for Explainability Agent

  createdAt DateTime @default(now())
}



// Every agent invocation — clean audit trail for judges and observability
model AgentRun {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  session   ConversationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  agentName String   // "CredibilityEngine" | "FinancialAnalysis" | "RiskAssessment" |
                      // "ScamDetection" | "GovSchemeMatching" | "GoalDiscovery" |
                      // "FutureSimulation" | "Explainability" | "Coach" | "Accessibility"
  input     Json
  output    Json
  latencyMs Int?
  status    AgentRunStatus @default(SUCCESS)

  createdAt DateTime @default(now())
}



// ---------- Conversation layer ----------
model ConversationSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  language  String   @default("en")
  startedAt DateTime @default(now())
  endedAt   DateTime?

  messages  Message[]
  agentRuns AgentRun[]
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  session   ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role      MessageRole
  content   String   // narration text only — never raw computation, per the LLM-narrates/Python-computes rule
  createdAt DateTime @default(now())
}
