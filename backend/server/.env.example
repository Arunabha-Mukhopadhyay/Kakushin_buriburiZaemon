# ArthSaathi — Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# .env is git-ignored; .env.example is committed as a reference.

# -------------------------------------------------------
# DATABASE — Postgres (Neon / Supabase free tier or local Docker)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# -------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/arthsaathi?sslmode=prefer"

# -------------------------------------------------------
# ELEVENLABS
# -------------------------------------------------------
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"
ELEVENLABS_AGENT_ID="your_kakushin_branch_agent_id_here"

# -------------------------------------------------------
# SERVER
# -------------------------------------------------------
PORT=3001
NODE_ENV=development
