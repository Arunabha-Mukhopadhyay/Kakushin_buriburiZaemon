# ArthSaathi Agents — Environment Variables
# Copy to .env and fill in real values

# LLM API (Gemini — used by Goal Discovery, Explainability, Coach, Accessibility agents)
GOOGLE_API_KEY="your_gemini_api_key_here"

# Path to the knowledge base folder (relative to this agents/ directory)
KNOWLEDGE_BASE_PATH="../knowledge_base"

# Path where FAISS indexes will be saved after ingestion
FAISS_INDEX_PATH="./rag/indexes"

# FastAPI port
PORT=8000
